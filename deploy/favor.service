[Unit]
Description=Favor human relationship ledger
After=network.target mariadb.service

[Service]
Type=simple
User=favor
Group=favor
WorkingDirectory=/var/www/mosshqq/favor/current
EnvironmentFile=/etc/favor/favor.env
ExecStart=/usr/bin/node dist/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
