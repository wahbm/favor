# Use a dedicated, unused domain. Replace example.com and certificate paths.
# Requires an existing certificate; do not enable with placeholder paths.
server {
    listen 80;
    server_name favor.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name favor.example.com;
    ssl_certificate /etc/letsencrypt/live/favor.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/favor.example.com/privkey.pem;
    client_max_body_size 8m;
    add_header Referrer-Policy no-referrer always;
    # Invitation tokens travel in the query string; avoid writing them to access logs.
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Reset client-supplied XFF because the app trusts the local proxy only.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
